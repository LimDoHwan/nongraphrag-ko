# 응답 생성·HippoRAG2 OpenIE(31B)·질의 합성·번역에 쓰는 vLLM OpenAI 호환 서버
GEMMA_URL=http://<vllm-host>:8000/v1/chat/completions
GEMMA_MODEL=google/gemma-4-31B-it
GEMMA_COOKIE=            # 인증 쿠키가 필요 없는 서버면 비워 둔다

# 4B OpenIE (src/track_02/graphrag/openie_4b.py, openie_4b_rerun.py)
OPENIE_4B_URL=http://<vllm-host>:8000/v1/chat/completions
OPENIE_4B_BASE=http://<vllm-host>:8000

# gpt-4o 판정자
OPENAI_KEY=

# 임베딩 모델 (huggingface-cli download BAAI/bge-m3 --local-dir models/bge-m3)
EMBEDDING_MODEL_PATH=./models/bge-m3
DEVICE=cuda
